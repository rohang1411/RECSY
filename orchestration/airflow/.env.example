# Copy to .env next to docker-compose.yaml before starting Airflow.
#
# On Linux/macOS, AIRFLOW_UID should usually be your host UID.
# On Windows/Docker Desktop, the default is usually fine.
AIRFLOW_UID=50000

# Airflow UI login created by the init service.
AIRFLOW_WWW_USER_USERNAME=airflow
AIRFLOW_WWW_USER_PASSWORD=airflow

# local: Airflow runs pnpm scripts inside the mounted repo.
# github_dispatch: Airflow triggers existing GitHub Actions workflows.
RECSY_EXECUTION_MODE=local

# Used inside the Airflow containers.
RECSY_PROJECT_ROOT=/opt/recsy

# Used only when RECSY_EXECUTION_MODE=github_dispatch.
RECSY_REPO_OWNER=rohang1411
RECSY_REPO_NAME=RECSY
RECSY_GITHUB_REF=main

# Optional fallback if you do not configure the github_recsy_actions Airflow
# Connection. Prefer an Airflow Connection for hosted or shared environments.
GITHUB_ACTIONS_TOKEN=
