{
  "name": "recsy-v2",
  "version": "0.1.0",
  "private": true,
  "description": "RECSY v2 — honest smartphone recommendations grounded in real reviews.",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts",
    "metering:maintain": "tsx --import ./scripts/load-env.mjs scripts/metering-maintenance.ts",
    "account:maintain": "tsx --import ./scripts/load-env.mjs scripts/account-maintenance.ts",
    "abuse:detect": "tsx --import ./scripts/load-env.mjs scripts/abuse-detect.ts",
    "billing:reconcile": "tsx --import ./scripts/load-env.mjs scripts/billing-reconcile.ts",
    "ops:alerts": "tsx --import ./scripts/load-env.mjs scripts/ops-alerts.ts",
    "metering:audit": "tsx --import ./scripts/load-env.mjs scripts/metering-audit.ts",
    "capacity:report": "tsx --import ./scripts/load-env.mjs scripts/capacity-report.ts",
    "check:bundle": "tsx scripts/check-bundle-budget.ts",
    "check:legal": "tsx scripts/check-legal-placeholders.ts",
    "db:ping": "tsx --import ./scripts/load-env.mjs scripts/db-ping.ts",
    "db:generate": "node --import ./scripts/load-env.mjs ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --import ./scripts/load-env.mjs ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --import ./scripts/load-env.mjs ./node_modules/drizzle-kit/bin.cjs studio",
    "db:setup": "tsx --import ./scripts/load-env.mjs scripts/db-setup.ts",
    "db:reset": "tsx --import ./scripts/load-env.mjs scripts/db-reset.ts",
    "db:smoke": "tsx --import ./scripts/load-env.mjs scripts/db-smoke.ts",
    "db:prune": "tsx --import ./scripts/load-env.mjs scripts/db-prune.ts",
