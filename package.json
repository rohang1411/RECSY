    "retrieval:smoke": "tsx --import ./scripts/load-env.mjs scripts/retrieval-smoke.ts",
    "ci:retrieval-fixture": "tsx scripts/seed-retrieval-eval-fixture.ts",
    "eval:ci-gate": "tsx scripts/ci-retrieval-gate.ts",
    "eval:rag:tuning": "tsx scripts/eval-rag-tuning.ts",
    "eval:retrieval": "tsx --import ./scripts/load-env.mjs scripts/eval-retrieval.ts",
    "eval:benchmark": "tsx --import ./scripts/load-env.mjs scripts/eval-benchmark.ts",
    "eval:check": "tsx --import ./scripts/load-env.mjs scripts/eval-check.ts",
    "eval:report": "tsx --import ./scripts/load-env.mjs scripts/eval-report.ts",
    "eval:load": "tsx --import ./scripts/load-env.mjs scripts/eval-load.ts",
    "eval:stage": "tsx --import ./scripts/load-env.mjs scripts/eval-stage.ts",
    "eval:corpus": "tsx --import ./scripts/load-env.mjs scripts/eval-corpus.ts",
    "eval:corpus:audit": "tsx --import ./scripts/load-env.mjs scripts/eval-corpus-audit.ts",
    "eval:snapshot": "tsx --import ./scripts/load-env.mjs scripts/eval-snapshot.ts",
    "eval:quality": "tsx --import ./scripts/load-env.mjs scripts/eval-quality.ts",
    "eval:review": "tsx scripts/eval-review.ts",
    "eval:review:import": "tsx scripts/eval-review-import.ts",
    "eval:http": "tsx --import ./scripts/load-env.mjs scripts/eval-http.ts",
    "eval:http:load": "tsx scripts/eval-http-load.ts",
