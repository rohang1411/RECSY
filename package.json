    "spec-embed:backfill": "tsx --import ./scripts/load-env.mjs scripts/backfill-spec-embeddings.ts",
    "mcp:server": "tsx --import ./scripts/load-env.mjs scripts/mcp-server.ts",
    "benchmark:retrieval": "tsx --import ./scripts/load-env.mjs scripts/benchmark-retrieval-latency.ts",
    "benchmark:api": "tsx scripts/benchmark-api-latency.ts",
    "verify:architecture": "tsx --import ./scripts/load-env.mjs scripts/verify-system-architecture-live.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "ingest": "tsx --import ./scripts/load-env.mjs scripts/ingest.ts",
    "ingest:auto": "tsx --import ./scripts/load-env.mjs scripts/ingest-auto.ts",
    "creator:watch": "tsx --import ./scripts/load-env.mjs scripts/creator-watch.ts",
    "source:watch": "tsx --import ./scripts/load-env.mjs scripts/source-watch.ts",
    "ingest:report": "tsx --import ./scripts/load-env.mjs scripts/ingest-report.ts",
    "ingest:smoke": "tsx --import ./scripts/load-env.mjs scripts/ingest-smoke.ts",
    "catalog:backfill-identities": "tsx --import ./scripts/load-env.mjs scripts/backfill/canonical-keys.ts",
    "catalog:refresh": "tsx --import ./scripts/load-env.mjs scripts/catalog-refresh.ts",
    "catalog:import-specs": "tsx --import ./scripts/load-env.mjs scripts/catalog-import-specs.ts",
    "catalog:promote": "tsx --import ./scripts/load-env.mjs scripts/catalog-promote.ts",
    "catalog:enrich-oem": "tsx --import ./scripts/load-env.mjs scripts/catalog-enrich-oem.ts",
    "catalog:enrich-gsmarena": "tsx --import ./scripts/load-env.mjs scripts/catalog-enrich-gsmarena.ts",
    "catalog:sync-mobileapi": "tsx --import ./scripts/load-env.mjs scripts/catalog-sync-mobileapi.ts",
    "catalog:prune": "tsx --import ./scripts/load-env.mjs scripts/catalog-prune.ts",
    "catalog:cleanup": "tsx --import ./scripts/load-env.mjs scripts/cleanup-corrupt-candidates.ts",
    "catalog:backfill-media": "tsx --import ./scripts/load-env.mjs scripts/catalog-backfill-media.ts",
    "catalog:backfill-images": "tsx --import ./scripts/load-env.mjs scripts/catalog-backfill-gsmarena-images.ts",
    "catalog:sync-flagships": "tsx --import ./scripts/load-env.mjs scripts/catalog-sync-flagships.ts",
    "catalog:auto": "tsx --import ./scripts/load-env.mjs scripts/catalog-auto.ts",
    "catalog:report": "tsx --import ./scripts/load-env.mjs scripts/catalog-report.ts",
    "prepare": "node scripts/prepare-husky.mjs",
    "eval:production:smoke": "node --import ./scripts/load-env.mjs scripts/eval-production-smoke.mjs",
    "eval:portal:smoke": "node --import ./scripts/load-env.mjs scripts/eval-portal-smoke.mjs",
