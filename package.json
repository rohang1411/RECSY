{
  "name": "recsy-v2",
  "version": "0.1.0",
  "private": true,
  "description": "RECSY v2 — honest smartphone recommendations grounded in real reviews.",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:ping": "tsx --env-file=.env.local scripts/db-ping.ts",
    "db:generate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env.local ./node_modules/drizzle-kit/bin.cjs studio",
    "db:setup": "tsx --env-file=.env.local scripts/db-setup.ts",
    "db:reset": "tsx --env-file=.env.local scripts/db-reset.ts",
    "db:smoke": "tsx --env-file=.env.local scripts/db-smoke.ts",
    "retrieval:smoke": "tsx --env-file=.env.local scripts/retrieval-smoke.ts",
    "ci:retrieval-fixture": "tsx scripts/seed-retrieval-eval-fixture.ts",
    "eval:retrieval": "tsx --env-file=.env.local scripts/eval-retrieval.ts",
    "scorecard:run": "tsx --env-file=.env.local scripts/scorecard-run.ts",
    "scorecard:auto": "tsx --env-file=.env.local scripts/scorecard-auto.ts",
    "spec-embed:backfill": "tsx --env-file=.env.local scripts/backfill-spec-embeddings.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "ingest": "tsx --env-file=.env.local scripts/ingest.ts",
    "ingest:auto": "tsx --env-file=.env.local scripts/ingest-auto.ts",
    "creator:watch": "tsx --env-file=.env.local scripts/creator-watch.ts",
    "ingest:report": "tsx --env-file=.env.local scripts/ingest-report.ts",
    "ingest:smoke": "tsx --env-file=.env.local scripts/ingest-smoke.ts",
    "catalog:backfill-identities": "tsx --env-file=.env.local scripts/backfill/canonical-keys.ts",
    "catalog:refresh": "tsx --env-file=.env.local scripts/catalog-refresh.ts",
    "catalog:import-specs": "tsx --env-file=.env.local scripts/catalog-import-specs.ts",
    "catalog:promote": "tsx --env-file=.env.local scripts/catalog-promote.ts",
    "catalog:sync-mobileapi": "tsx --env-file=.env.local scripts/catalog-sync-mobileapi.ts",
    "catalog:report": "tsx --env-file=.env.local scripts/catalog-report.ts",
    "prepare": "node scripts/prepare-husky.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.64",
    "@mozilla/readability": "^0.6.0",
    "@supabase/supabase-js": "^2.103.3",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.99.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.168",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gpt-tokenizer": "^3.4.0",
    "linkedom": "^0.18.12",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "p-limit": "^7.3.0",
    "p-retry": "^8.0.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "youtubei.js": "^17.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
