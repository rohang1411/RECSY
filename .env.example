# -----------------------------------------------------------------------------
# RECSY v2 environment variables
# Copy this file to `.env.local` and fill in the blanks for local development.
# `src/env.ts` validates these at build time; missing required values will
# fail the build fast.
# -----------------------------------------------------------------------------

# --- Deployment ---------------------------------------------------------------
# One of: development | preview | production
NODE_ENV=development

# --- Supabase / Postgres ------------------------------------------------------
# Server-side Postgres connection string (service role). Used by Drizzle.
# Format: postgresql://postgres:<password>@<host>:5432/postgres
DATABASE_URL=
# Normal application namespace. The campaign sets an isolated eval_* schema.
DATABASE_SCHEMA=public

# Supabase public URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (server-only; bypasses RLS). DO NOT expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM providers ------------------------------------------------------------
# Primary provider: "gemini" (default) or "groq".
# "controlled" is restricted to development + eval_* + authenticated loopback.
# The campaign supplies its URL/token automatically; never use it in production.
# EVAL_CONTROLLED_PROVIDER_URL=http://127.0.0.1:3210
# EVAL_CONTROLLED_PROVIDER_TOKEN=replace-with-at-least-16-random-characters
LLM_PROVIDER=gemini

# Google AI Studio API key (free tier). https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional Groq API key for ultra-fast extraction (14.4k req/day free). https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=

# Optional NVIDIA NIM API key (1,000 free inference credits). https://build.nvidia.com
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_KEY_2=

# Optional Cerebras Cloud API key (1M tokens/day free). https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Optional GitHub Models personal access token. https://github.com/marketplace/models
GITHUB_MODELS_TOKEN=

# Optional OpenRouter API key for free overflow models. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Intelligent Model Gateway & Router configuration
LLM_ROUTER_ENABLED=true
LLM_FAST_MODEL=llama-3.1-8b-instant
LLM_BALANCED_MODEL=gemini-3-flash-preview
LLM_CHAT_MODEL=gemini-3-flash-preview

# Optional backup keys (separate Google Cloud / AI Studio projects). Used in cyclic order when a prior key hits 429 / daily quota.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
# Optional additional keys, in order, separated by commas. No NEXT_PUBLIC_ prefix.
GEMINI_API_KEYS_EXTRA=

# Optional local pacing defaults; these are configured limits, not verified provider entitlements.
# Check the actual project/model quota before planning a live campaign.
# Use "off" on paid tiers or multi-instance hosts (in-process counters are not shared across machines).
GEMINI_RATE_LIMIT_PROFILE=off
GEMINI_FREE_RPM=5
GEMINI_FREE_TPM_INPUT=250000
GEMINI_FREE_RPD=20

# Google Cloud Monitoring quota fetch for /internal/pipeline.
# Project IDs follow numbered key slots (1-4 always, up to the last configured _5/_6), then each extra key.
# The service account needs Monitoring Viewer (roles/monitoring.viewer).
GOOGLE_CLOUD_QUOTA_PROJECT_IDS=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Default reasoning-heavy model (ranker tie-breaker, aspect extraction).
LLM_REASONING_MODEL=gemini-2.5-pro

# Embedding model. `gemini-embedding-001` is Google's current GA model;
# `text-embedding-004` was retired on v1beta in early 2026. The output is
# truncated to 768 dims via Matryoshka to match the DB `vector(768)` column
# — that dimension is locked in code (gemini.ts) on purpose so an env typo
# can't desync from the schema.
LLM_EMBEDDING_MODEL=gemini-embedding-001

# --- Feature flags ------------------------------------------------------------
# Turn LLM response caching on/off (default: on). Set to "false" to disable.
LLM_CACHE_ENABLED=true

# Optional: structured Flash rerank after MMR in hybrid retrieval (+1 LLM call
# per query). Default off. `/api/ask` reads this via `@/env`.
RETRIEVAL_LLM_RERANK=false

# Internal, read-only pipeline dashboard at /internal/pipeline. Default off.
INTERNAL_DASHBOARD_ENABLED=false
# Required for evaluation APIs in production when the internal dashboard is enabled.
# Set to a random value of at least 16 characters; never expose it in NEXT_PUBLIC_*.
INTERNAL_EVAL_TOKEN=

# --- Catalog refresh ----------------------------------------------------------
# Optional licensed structured specs source. Used only by `pnpm catalog:sync-mobileapi`.
# The catalog import/promote path still makes zero LLM calls.
MOBILEAPI_API_KEY=

# --- YouTube transcript fallbacks --------------------------------------------
# Current fallback order:
# 1. Built-in youtubei.js / timedtext fetch
# 2. yt-dlp subtitle-only fallback
# 3. Python youtube-transcript-api fallback
#
# Ban-risk defaults are conservative: no cookies by default, no audio/video
# download, one retry max, and a pause between external transcript attempts.
YOUTUBE_TRANSCRIPT_EXTERNAL_ENABLED=true
YOUTUBE_TRANSCRIPT_TIMEOUT_MS=20000
YOUTUBE_TRANSCRIPT_EXTERNAL_MIN_GAP_MS=3000
YTDLP_ENABLED=true
YTDLP_PATH=yt-dlp
YTDLP_SLEEP_REQUESTS_SECONDS=2

# Optional, only if YouTube blocks unauthenticated subtitle requests. Prefer a
# throwaway/low-risk YouTube session if you choose to use cookies.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_BASE64=
YTDLP_PROXY=
YTDLP_EXTRACTOR_ARGS=

YOUTUBE_TRANSCRIPT_API_ENABLED=true
YOUTUBE_TRANSCRIPT_PYTHON=python

# Optional official Reddit app-only OAuth. Recommended for GitHub Actions or
# other runner environments where public `www.reddit.com/*.json` requests may
# receive intermittent 403s.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Observability ------------------------------------------------------------
# Minimum log level: trace | debug | info | warn | error | fatal. Default: info.
LOG_LEVEL=info

# Optional Sentry DSN (leave blank to disable error reporting).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Public commit SHA embedded in the health endpoint. Populated in CI.
NEXT_PUBLIC_COMMIT_SHA=dev

# Canonical site URL for OG/Twitter metadata. Vercel injects VERCEL_URL in CI.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- plan25: metering, auth, billing -------------------------------------------
# Quota enforcement mode: off (today's unmetered behaviour), shadow (log decisions, never block), enforce
QUOTA_MODE=off
# Test override for local load tests only (ignored when DATABASE_URL is hosted)
# QUOTA_TEST_OVERRIDE=

# Free & anonymous limits
FREE_DAILY_QUERIES=2
ANON_DAILY_QUERIES=2
ANON_IP_DAILY_CAP=30
DEVICE_ACCOUNT_CAP=3
BYOK_DAILY_CAP=100
CLARIFY_FREE_CAP=10
MAX_INFLIGHT_FREE=1
MAX_INFLIGHT_PRO=2
LEASE_TTL_SECONDS=75
METERING_DB_TIMEOUT_MS=3000
AUTH_VERIFY_TIMEOUT_MS=2000
GLOBAL_DAILY_PLATFORM_CAP_DEFAULT=0

# Cryptographic HMAC secrets (required in production; min 32 chars)
DEVICE_ID_SECRET=
IP_HASH_SECRET=

# IP proxy detection: platform header name (defaults to Vercel header)
# TRUST_PROXY_HEADER=

# Auth driver: supabase | fake (fake is local-only)
SIGNUPS_ENABLED=true
AUTH_DRIVER=supabase
MAINTENANCE_MODE=false

# Cloudflare Turnstile anti-bot
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Billing configuration (Stripe)
BILLING_ENABLED=false
BILLING_PROVIDER=stripe
# BILLING_ALLOWLIST_EMAILS=
# STRIPE_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_API_VERSION=2024-12-18.acacia
# STRIPE_PRICE_PACK_S=price_...
# STRIPE_PRICE_PACK_M=price_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
PAST_DUE_GRACE_DAYS=3

# Transactional email (Resend / Postmark)
# EMAIL_PROVIDER=resend
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=RECSY <notifications@recsy.com>
NEXT_PUBLIC_SUPPORT_EMAIL=support@recsy.com

# Raw query logging to cache (false in production)
LLM_CACHE_STORE_RAW=false

# Operator alert webhook
# ALERT_WEBHOOK_URL=

# Rate limits per authenticated user
USER_RATE_RECOMMEND_PER_MIN=12
USER_RATE_ASK_PER_MIN=20


# Optional runtime performance flags default JSON (Plan 26 WP-01).
# Falls back to hardcoded defaults if unset or invalid.
# Example: PERF_FLAGS_DEFAULT_JSON={"ask_streaming":"canary","ask_streaming_canary_pct":10}
PERF_FLAGS_DEFAULT_JSON=
