# -----------------------------------------------------------------------------
# RECSY v2 environment variables
# Copy this file to `.env.local` and fill in the blanks for local development.
# `src/env.ts` validates these at build time; missing required values will
# fail the build fast.
# -----------------------------------------------------------------------------

# --- Deployment ---------------------------------------------------------------
# One of: development | preview | production
NODE_ENV=development

# --- Supabase / Postgres ------------------------------------------------------
# Server-side Postgres connection string (service role). Used by Drizzle.
# Format: postgresql://postgres:<password>@<host>:5432/postgres
DATABASE_URL=

# Supabase public URL (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (server-only; bypasses RLS). DO NOT expose to browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM providers ------------------------------------------------------------
# Primary provider: "gemini" (default) or "groq".
LLM_PROVIDER=gemini

# Google AI Studio API key (free tier). https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional Groq API key for fallback. https://console.groq.com/keys
GROQ_API_KEY=

# Default chat/completion model (matches provider's catalog).
LLM_CHAT_MODEL=gemini-3-flash-preview

# Optional backup keys (separate Google Cloud / AI Studio projects). Used in cyclic order when a prior key hits 429 / daily quota.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Set to google_ai_studio_free to pace requests per key (defaults: 5 RPM, 250k input TPM rolling 60s, 20 RPD UTC).
# Use "off" on paid tiers or multi-instance hosts (in-process counters are not shared across machines).
GEMINI_RATE_LIMIT_PROFILE=off
GEMINI_FREE_RPM=5
GEMINI_FREE_TPM_INPUT=250000
GEMINI_FREE_RPD=20

# Default reasoning-heavy model (ranker tie-breaker, aspect extraction).
LLM_REASONING_MODEL=gemini-2.5-pro

# Embedding model. `gemini-embedding-001` is Google's current GA model;
# `text-embedding-004` was retired on v1beta in early 2026. The output is
# truncated to 768 dims via Matryoshka to match the DB `vector(768)` column
# — that dimension is locked in code (gemini.ts) on purpose so an env typo
# can't desync from the schema.
LLM_EMBEDDING_MODEL=gemini-embedding-001

# --- Feature flags ------------------------------------------------------------
# Turn LLM response caching on/off (default: on). Set to "false" to disable.
LLM_CACHE_ENABLED=true

# Optional: structured Flash rerank after MMR in hybrid retrieval (+1 LLM call
# per query). Default off. `/api/ask` reads this via `@/env`.
RETRIEVAL_LLM_RERANK=false

# Internal, read-only pipeline dashboard at /internal/pipeline. Default off.
INTERNAL_DASHBOARD_ENABLED=false

# --- Catalog refresh ----------------------------------------------------------
# Optional licensed structured specs source. Used only by `pnpm catalog:sync-mobileapi`.
# The catalog import/promote path still makes zero LLM calls.
MOBILEAPI_API_KEY=

# --- YouTube transcript fallbacks --------------------------------------------
# Current fallback order:
# 1. Built-in youtubei.js / timedtext fetch
# 2. yt-dlp subtitle-only fallback
# 3. Python youtube-transcript-api fallback
#
# Ban-risk defaults are conservative: no cookies by default, no audio/video
# download, one retry max, and a pause between external transcript attempts.
YOUTUBE_TRANSCRIPT_EXTERNAL_ENABLED=true
YOUTUBE_TRANSCRIPT_TIMEOUT_MS=20000
YOUTUBE_TRANSCRIPT_EXTERNAL_MIN_GAP_MS=3000
YTDLP_ENABLED=true
YTDLP_PATH=yt-dlp
YTDLP_SLEEP_REQUESTS_SECONDS=2

# Optional, only if YouTube blocks unauthenticated subtitle requests. Prefer a
# throwaway/low-risk YouTube session if you choose to use cookies.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_BASE64=
YTDLP_PROXY=
YTDLP_EXTRACTOR_ARGS=

YOUTUBE_TRANSCRIPT_API_ENABLED=true
YOUTUBE_TRANSCRIPT_PYTHON=python

# --- Observability ------------------------------------------------------------
# Minimum log level: trace | debug | info | warn | error | fatal. Default: info.
LOG_LEVEL=info

# Optional Sentry DSN (leave blank to disable error reporting).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Public commit SHA embedded in the health endpoint. Populated in CI.
NEXT_PUBLIC_COMMIT_SHA=dev

# Canonical site URL for OG/Twitter metadata. Vercel injects VERCEL_URL in CI.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
